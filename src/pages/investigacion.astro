---
import Layout from '../layouts/Layout.astro';

const projects = [
  ['Corredor Biológico Chichinautzin, Morelos','Impacto de la estructura forestal en los macrolíquenes cortícolas del Corredor Biológico Chichinautzin, Morelos','Análisis de parámetros ecológicos y densidad forestal para determinar la salud y conservación de la macroflora liquénica.','https://images.unsplash.com/photo-1761461922930-9afd5bf09593?auto=format&fit=crop&w=1000&q=80'],
  ['Tehuacán-Cuicatlán y Cuetzalán, Puebla','Estudio de la flora liquénica de la región de Tehuacán-Cuicatlán y del bosque mesófilo de montaña de Cuetzalán, Puebla','Inventario florístico comparativo entre zonas áridas de alta radiación y bosques húmedos de niebla.','https://images.unsplash.com/photo-1757912190224-a0b069bf4130?auto=format&fit=crop&w=1000&q=80'],
  ['Parque Nacional La Malinche, Puebla-Tlaxcala','Composición de las comunidades liquénicas del Parque Nacional La Malinche, Puebla-Tlaxcala','Evaluación del gradiente altitudinal en la distribución de especies liquénicas en el estrato arbóreo.','https://images.unsplash.com/photo-1702474447694-e8c8dc2508e0?auto=format&fit=crop&w=1000&q=80'],
];
const books = [
  ['2016','Lichen Flora of the Greater Sonoran Desert Region & Mexico','Estudios sobre la flora liquénica y diversidad en bosques de montaña de México','https://images.unsplash.com/photo-1517770413964-df8ca61194a6?auto=format&fit=crop&w=1000&q=80'],
  ['2016','Greater Sonoran Desert Lichen Flora, Vol. III','Canoparmelia in Lichen Flora of the Greater Sonoran Desert Region','https://images.unsplash.com/photo-1594305342010-1f62e803490f?auto=format&fit=crop&w=1000&q=80'],
];
const publications = [
  ['2016','Herrera-Campos, M.A., Pérez-Pérez, R.E. y T.H. Nash III','Estudios sobre la flora liquénica y diversidad en bosques de montaña de México','https://images.unsplash.com/photo-1720169611634-a83e65f690b8?auto=format&fit=crop&w=1000&q=80'],
  ['2016','Pérez-Pérez, R.E. and T.H. Nash III','Canoparmelia in Lichen Flora of the Greater Sonoran Desert Region','https://images.unsplash.com/photo-1775302032848-1e4a6ee538cd?auto=format&fit=crop&w=1000&q=80'],
  ['2016','Nash, T.H., III, Pérez-Pérez, R.E. and J.A. Elix','Taxonomía y revisión del género Xanthoparmelia en el centro y sur de México','https://images.unsplash.com/photo-1653794280668-963f2c25d173?auto=format&fit=crop&w=1000&q=80'],
];
---
<Layout title="Investigación | Laboratorio de Liquenología BUAP">
  <section class="hero"><div class="hero-bg"></div><div class="hero-content"><span>Proyectos y publicaciones</span><h1>Líneas de <em>investigación</em></h1><p>Estudios taxonómicos y ecológicos sobre la flora liquénica en diversos ecosistemas de México.</p></div></section>
  <main>
    <section class="wrap"><h2>Proyectos de investigación</h2><div class="rule"></div><div class="projects">{projects.map(([place,title,text,image])=><article><img src={image} alt={title} loading="lazy"/><div class="shade"></div><span class="badge">Cargo: Responsable</span><div class="project-copy"><small>⌖ {place}</small><h3>{title}</h3><p>{text}</p></div></article>)}</div></section>
    <section class="cream"><div class="wrap"><div class="section-intro"><div><span class="kicker">Obra editorial</span><h2>Libros y capítulos</h2><div class="rule"></div></div><p>Conoce las obras de referencia que reúnen el conocimiento taxonómico de la flora liquénica de México.</p></div><div class="book-grid">{books.map(([year,source,title,image])=><article class="book-card"><img src={image} alt={source} loading="lazy"/><div class="book-shade"></div><span>{year}</span><div><small>{source}</small><h3>{title}</h3><a href="#publicaciones">Ver referencia →</a></div></article>)}</div></div></section>
    <section class="wrap" id="publicaciones"><div class="section-intro"><div><span class="kicker">Producción científica</span><h2>Publicaciones</h2><div class="rule"></div></div><p>Artículos y aportaciones bibliográficas fruto del trabajo de investigación del laboratorio.</p></div><div class="publication-grid">{publications.map(([year,authors,title,image])=><article class="publication-card"><div class="publication-image"><img src={image} alt={title} loading="lazy"/><span>{year}</span></div><div class="publication-copy"><small>{authors}</small><h3>{title}</h3><button type="button">Ver cita</button></div></article>)}</div></section>
  </main>
</Layout>
<style>
  .hero{position:relative;isolation:isolate;background:#12291c;color:#fff}.hero-bg{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(18,41,28,.95),rgba(18,41,28,.45)),url('https://images.unsplash.com/photo-1614308460927-5024ba2e1dcb?auto=format&fit=crop&w=1800&q=80') center/cover}.hero-content,.wrap{max-width:1200px;margin:auto;padding:6rem 1.5rem}.hero-content span,.kicker,.badge{font:.7rem 'DM Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:#c9e265}.hero h1{margin:1.5rem 0 0;font:600 clamp(3rem,7vw,6rem)/.95 'Fraunces',serif}.hero em{font-weight:400;color:#c9e265}.hero p{max-width:40rem;color:#fffC;font-size:1.15rem;line-height:1.6}.wrap>h2,.section-intro h2{margin:0;color:#1f4a32;font:600 clamp(2.5rem,5vw,4.5rem)/1 'Fraunces',serif}.rule{width:3.5rem;height:.25rem;margin:1.3rem 0 3rem;background:#c9e265}.projects{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem}.projects article{position:relative;min-height:34rem;display:flex;align-items:end;overflow:hidden;border-radius:1rem;background:#12291c;color:#fff;isolation:isolate}.projects img,.shade,.book-card img,.book-shade{position:absolute;inset:0;width:100%;height:100%}.projects img,.book-card img{z-index:-2;object-fit:cover;transition:.7s}.shade,.book-shade{z-index:-1;background:linear-gradient(to top,#12291c,rgba(18,41,28,.45),transparent)}.projects article:hover img,.book-card:hover img{transform:scale(1.08)}.badge{position:absolute;top:1.25rem;left:1.25rem;padding:.45rem .75rem;border-radius:.25rem;background:#1f4a32}.project-copy{padding:1.75rem}.project-copy small{color:#c9e265;font-weight:700}.project-copy h3{margin:.75rem 0;font:600 1.55rem/1.15 'Fraunces',serif}.project-copy p{color:#fffc;line-height:1.55}.cream{background:#f4f1e8}.section-intro{display:flex;justify-content:space-between;align-items:end;gap:3rem;margin-bottom:3rem}.section-intro>p{max-width:22rem;color:#5c6a60;line-height:1.6}.kicker{display:block;margin-bottom:1rem;color:#2f6b46}.book-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.25rem}.book-card{position:relative;min-height:25rem;display:flex;align-items:end;overflow:hidden;border-radius:1rem;background:#12291c;color:#fff;isolation:isolate}.book-card>span{position:absolute;top:1.5rem;left:1.5rem;color:#c9e265;font:2rem 'Fraunces',serif}.book-card>div:last-child{padding:2rem}.book-card small{color:#c9e265;font: .7rem 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase}.book-card h3{margin:.75rem 0 1rem;font:600 1.8rem/1.15 'Fraunces',serif}.book-card a{color:#c9e265;font-weight:700;text-decoration:none}.publication-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem}.publication-card{overflow:hidden;border:1px solid #dcdfd3;border-radius:1rem;background:#fff;transition:.3s}.publication-card:hover{transform:translateY(-.4rem);box-shadow:0 1.5rem 3rem -2rem rgba(18,41,28,.5)}.publication-image{position:relative;height:13rem;overflow:hidden;background:#1f4a32}.publication-image img{width:100%;height:100%;object-fit:cover;transition:.5s}.publication-card:hover img{transform:scale(1.07)}.publication-image span{position:absolute;left:1rem;bottom:1rem;border-radius:.35rem;background:#c9e265;padding:.35rem .65rem;color:#12291c;font:600 1.2rem 'Fraunces',serif}.publication-copy{padding:1.5rem}.publication-copy small{color:#5c6a60;font-size:.8rem;line-height:1.4}.publication-copy h3{min-height:5rem;margin:1rem 0;color:#1f4a32;font:600 1.3rem/1.2 'Fraunces',serif}.publication-copy button{border:1px solid #dcdfd3;border-radius:999px;background:#fff;padding:.6rem 1rem;color:#1f4a32;font-weight:700}@media(max-width:800px){.projects,.publication-grid{grid-template-columns:1fr}.book-grid{grid-template-columns:1fr}.section-intro{display:block}.section-intro>p{margin-top:1rem}}
</style>
