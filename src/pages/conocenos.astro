---
import Layout from '../layouts/Layout.astro';

const studies = [
  ['2006 – 2009', 'Posdoctorado', 'Universidad Estatal de Arizona (ASU) en Tempe, Az. USA'],
  ['2005', 'Doctorado en Ciencias', 'Facultad de Ciencias Biológicas, Universidad Autónoma del Estado de Morelos'],
  ['1990', 'Licenciatura en Biología', 'Facultad de Ciencias Biológicas, Universidad Autónoma del Estado de Morelos'],
];
---
<Layout title="Conócenos | Laboratorio de Liquenología BUAP">
  <section class="hero"><div class="hero-bg"></div><div class="hero-content"><span>Facultad de Ciencias Biológicas</span><h1>¿Quién está detrás de <em>liquenes.com</em>?</h1><p>Conoce a la investigadora responsable y la trayectoria académica del laboratorio.</p></div></section>
  <main>
    <section class="profile wrap">
      <div class="profile-card">
        <div class="avatar">RP<strong>Investigadora titular</strong></div>
        <div><h2>Dra. Rosa Emilia Pérez-Pérez</h2><p class="role">Responsable del Laboratorio de Liquenología</p>
          <ul><li><b>Laboratorio:</b> Biología Vegetal</li><li><b>Ubicación:</b> Edif. 1 BIO 1, Cubículo 307, Ciudad Universitaria</li><li><b>Correo:</b> <a href="mailto:emilia.perez@correo.buap.mx">emilia.perez@correo.buap.mx</a></li></ul>
        </div>
      </div>
    </section>
    <section class="cream quote-section"><div class="narrow"><h2>Línea de investigación</h2><div class="rule"></div><p class="accent">Taxonomía y Ecología de líquenes</p><blockquote>“El tema que he venido desarrollando desde los estudios del doctorado, ha sido el de analizar el impacto de la estructura forestal en las comunidades liquénicas. Para cumplir con este objetivo, es necesario identificar cuáles son las especies que conforman dichas comunidades. De aquí que se haga un estudio integral entre la taxonomía y ecología de los líquenes.”</blockquote></div></section>
    <section class="wrap academic"><div class="narrow"><h2>Formación académica</h2><div class="rule"></div><ol>{studies.map(([year, degree, institution]) => <li><span>{year}</span><div><h3>{degree}</h3><p>{institution}</p></div></li>)}</ol></div></section>
    <section class="cream contact-direct"><div class="narrow"><h2>Contacto directo</h2><div class="rule"></div><p>Escribe un mensaje directamente para dudas sobre investigación, colaboraciones o tesis.</p><form id="contact-form"><div class="two"><label>Nombre completo *<input name="nombre" required /></label><label>Correo electrónico *<input name="correo" type="email" required /></label></div><label>Asunto *<input name="asunto" required /></label><label>Mensaje *<textarea name="mensaje" rows="5" required></textarea></label><button>Enviar mensaje</button></form></div></section>
  </main>
</Layout>
<script>
  document.querySelector('#contact-form')?.addEventListener('submit', (event) => { event.preventDefault(); const form = event.currentTarget as HTMLFormElement; const data = new FormData(form); window.location.href = `mailto:emilia.perez@correo.buap.mx?subject=${encodeURIComponent(String(data.get('asunto')))}&body=${encodeURIComponent(`Nombre: ${data.get('nombre')}\nCorreo: ${data.get('correo')}\n\n${data.get('mensaje')}`)}`; });
</script>
<style>
  .hero{position:relative;isolation:isolate;background:#12291c;color:#fff}.hero-bg{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(18,41,28,.95),rgba(18,41,28,.55)),url('https://images.unsplash.com/photo-1727388828879-2e24343af784?auto=format&fit=crop&w=1800&q=80') center/cover;opacity:.9}.hero-content,.wrap{max-width:1200px;margin:auto;padding:6rem 1.5rem}.hero-content span,.role,.accent{color:#c9e265;font: .7rem 'DM Mono',monospace;letter-spacing:.14em;text-transform:uppercase}.hero h1{max-width:800px;margin:1.5rem 0 0;font:600 clamp(3rem,7vw,6rem)/.95 'Fraunces',serif}.hero em,h2 em{font-weight:400;color:#c9e265}.hero p{max-width:38rem;font-size:1.15rem;color:#fffC;line-height:1.6}.profile{margin-top:-3rem;position:relative}.profile-card{display:flex;align-items:center;gap:3rem;padding:3rem;border:1px solid #dcdfd3;border-radius:1.5rem;background:#fff;box-shadow:0 1.5rem 4rem -3rem #12291c}.avatar{display:grid;place-items:center;width:11rem;height:11rem;flex:none;border-radius:50%;background:linear-gradient(135deg,#d9a43b,#2f6b46);color:#fff;font:600 3.5rem 'Fraunces',serif;position:relative}.avatar strong{position:absolute;bottom:-1rem;white-space:nowrap;border-radius:999px;background:#1f4a32;padding:.5rem 1rem;color:#fff;font: .65rem 'DM Mono',monospace;text-transform:uppercase}.profile h2,.narrow h2{margin:0;color:#1f4a32;font:600 clamp(2.5rem,5vw,4.5rem)/1 'Fraunces',serif}.role{margin:.75rem 0 1.5rem;color:#d9a43b}.profile li{margin:.75rem 0;color:#5c6a60}.profile a{color:#2f6b46;font-weight:700}.cream{background:#f4f1e8}.narrow{max-width:850px;margin:auto;padding:6rem 1.5rem}.rule{width:3.5rem;height:.25rem;margin:1.3rem 0;background:#c9e265}.accent{color:#d9a43b;font:600 1.1rem 'Figtree',sans-serif;letter-spacing:0}.quote-section blockquote{margin:2rem 0 0;border-left:.5rem solid #2f6b46;border-radius:.5rem;background:#fff;padding:2.5rem;color:#16201a;font:italic 1.35rem/1.7 'Fraunces',serif}.academic ol{padding:0;list-style:none}.academic li{display:flex;align-items:center;gap:2rem;margin:1rem 0;padding:1.5rem 2rem;border:1px solid #dcdfd3;border-radius:1rem;background:#f4f1e8}.academic li span{width:9rem;padding:.75rem;border-radius:.5rem;background:#c9e26566;color:#1f4a32;font: .85rem 'DM Mono',monospace;text-align:center}.academic h3{margin:0;color:#1f4a32;font:600 1.3rem 'Fraunces',serif}.academic p{margin:.3rem 0 0;color:#5c6a60}.contact-direct{text-align:center}.contact-direct form{margin-top:2.5rem;padding:2.5rem;border:1px solid #dcdfd3;border-radius:1rem;background:#fff;text-align:left}.two{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem}label{display:block;margin:1rem 0;color:#16201a;font-weight:700}input,textarea{display:block;width:100%;margin-top:.5rem;padding:.85rem;border:1px solid #dcdfd3;border-radius:.5rem;font:inherit}button{border:0;border-radius:999px;background:#2f6b46;padding:.9rem 1.7rem;color:#fff;font-weight:700;cursor:pointer}@media(max-width:700px){.profile-card{flex-direction:column;text-align:center}.two{grid-template-columns:1fr}.academic li{display:block}.academic li span{display:block;width:auto;margin-bottom:1rem}}
</style>
