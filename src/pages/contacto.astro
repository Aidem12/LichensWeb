---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contacto | Laboratorio de Liquenología BUAP">
  <main class="contact-page">
    <section class="contact-hero">
      <div class="contact-overlay"></div>
      <div class="contact-shell">
        <div class="contact-copy">
          <span>Contáctanos</span>
          <h1>¿Encontraste un <em>liquen</em> y no sabes cuál es?</h1>
          <address>
            <p>Edificio BIO 1, Ciudad Universitaria</p>
            <p>Col. San Manuel, Puebla, Pue., México</p>
            <a href="mailto:liquenologia@correo.buap.mx">liquenologia@correo.buap.mx</a>
          </address>
        </div>
        <form id="contacto-form">
          <label>Nombre<input name="nombre" required /></label>
          <label>Correo electrónico<input name="correo" type="email" required /></label>
          <label>Mensaje<textarea name="mensaje" rows="4" required></textarea></label>
          <button>Enviar mensaje</button>
        </form>
      </div>
    </section>
  </main>
</Layout>
<script>
  document.querySelector('#contacto-form')?.addEventListener('submit', (event) => {
    event.preventDefault();
    const form = event.currentTarget as HTMLFormElement;
    const data = new FormData(form);
    window.location.href = `mailto:liquenologia@correo.buap.mx?subject=Contacto desde liquenes.com&body=${encodeURIComponent(`Nombre: ${data.get('nombre')}\nCorreo: ${data.get('correo')}\n\n${data.get('mensaje')}`)}`;
  });
</script>
<style>
  .contact-page { min-height: calc(100vh - 6.1rem); }
  .contact-hero { position: relative; min-height: calc(100vh - 6.1rem); display: grid; align-items: center; isolation: isolate; background: #12432f url('https://images.unsplash.com/photo-1761461922930-9afd5bf09593?auto=format&fit=crop&w=2000&q=80') center/cover; color: #fff; }
  .contact-overlay { position: absolute; inset: 0; z-index: -1; background: rgba(14, 69, 47, .84); }
  .contact-shell { width: min(1200px, 100%); margin: 0 auto; padding: 5rem 1.5rem; display: grid; grid-template-columns: 1fr 1fr; gap: 7rem; align-items: center; }
  .contact-copy > span { color: var(--lime, #c9e265); font: .7rem 'DM Mono', monospace; letter-spacing: .16em; text-transform: uppercase; }
  .contact-copy h1 { max-width: 34rem; margin: 1.5rem 0 3rem; font: 600 clamp(3rem, 6vw, 5.4rem)/.98 'Fraunces', Georgia, serif; letter-spacing: -.04em; }
  .contact-copy h1 em { color: var(--lime, #c9e265); font-weight: 400; }
  address { font-style: normal; color: rgba(255,255,255,.82); line-height: 1.35; }
  address p { margin: .5rem 0; }
  address a { color: var(--lime, #c9e265); font: .75rem 'DM Mono', monospace; letter-spacing: .08em; }
  form { display: flex; flex-direction: column; gap: 1.15rem; }
  label { color: var(--lime, #c9e265); font: .7rem 'DM Mono', monospace; letter-spacing: .12em; text-transform: uppercase; }
  input, textarea { display: block; width: 100%; margin-top: .8rem; padding: .7rem 0; border: 0; border-bottom: 1px solid rgba(255,255,255,.52); border-radius: 0; outline: 0; background: transparent; color: #fff; font: 1rem 'Figtree', sans-serif; resize: vertical; }
  input:focus, textarea:focus { border-bottom-color: var(--lime, #c9e265); }
  button { align-self: flex-start; margin-top: 1rem; border: 0; border-radius: 999px; background: var(--lime, #c9e265); padding: .95rem 2rem; color: #12291c; font-weight: 700; cursor: pointer; transition: transform .2s, background .2s; }
  button:hover { transform: translateY(-2px); background: #fff; }
  @media (max-width: 760px) { .contact-shell { grid-template-columns: 1fr; gap: 3rem; } .contact-copy h1 { margin-bottom: 2rem; } .contact-hero { min-height: auto; } }
</style>
