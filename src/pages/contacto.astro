---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto | Laboratorio de Liquenología BUAP">
  
  <!-- BANNER ENCABEZADO -->
  <section class="page-banner">
    <div class="container">
      <span class="banner-tag">Facultad de Ciencias Biológicas</span>
      <h1>Contáctanos</h1>
      <p>Información de ubicación física del laboratorio y medio de contacto directo con la encargada.</p>
    </div>
  </section>

  <!-- SECCIÓN DE CONTACTO Y UBICACIÓN FÍSICA -->
  <section class="contact-section">
    <div class="container">
      <div class="contact-grid">
        
        <!-- Ficha de Ubicación e Información de la Encargada -->
        <div class="info-card">
          <div class="info-header">
            <span class="badge-role">Encargada del Laboratorio</span>
            <h2>Dra. Rosa Emilia Pérez-Pérez</h2>
            <p class="sub-role">Laboratorio de Biología Vegetal — Liquenología</p>
          </div>

          <div class="info-details">
            <div class="detail-item">
              <div class="icon-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <strong>Ubicación Física:</strong>
                <p>Edificio 1 BIO 1, Cubículo 307<br />Ciudad Universitaria, San Manuel<br />Puebla, Pue., México</p>
              </div>
            </div>

            <div class="detail-item">
              <div class="icon-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
              </div>
              <div>
                <strong>Institución:</strong>
                <p>Facultad de Ciencias Biológicas<br />Benemérita Universidad Autónoma de Puebla (BUAP)</p>
              </div>
            </div>

            <div class="detail-item">
              <div class="icon-wrap">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </div>
              <div>
                <strong>Correo Electrónico Institucional:</strong>
                <p><a href="mailto:emilia.perez@correo.buap.mx" class="email-link">emilia.perez@correo.buap.mx</a></p>
              </div>
            </div>
          </div>
        </div>

        <!-- Formulario Simplificado de Correo -->
        <div class="form-wrapper">
          <div class="form-header">
            <h3>Redactar Correo Directo</h3>
            <p>Escribe tu consulta o mensaje para la encargada del laboratorio:</p>
          </div>

          <form id="contacto-form" class="direct-form">
            <div class="form-group">
              <label for="nombre">Nombre Completo *</label>
              <input type="text" id="nombre" name="nombre" placeholder="Tu nombre y apellidos" required />
            </div>

            <div class="form-group">
              <label for="correo">Correo de Contacto *</label>
              <input type="email" id="correo" name="correo" placeholder="tu.correo@ejemplo.com" required />
            </div>

            <div class="form-group">
              <label for="asunto">Asunto *</label>
              <input type="text" id="asunto" name="asunto" placeholder="Motivo de tu mensaje" required />
            </div>

            <div class="form-group">
              <label for="mensaje">Mensaje *</label>
              <textarea id="mensaje" name="mensaje" rows="5" placeholder="Escribe tu mensaje aquí..." required></textarea>
            </div>

            <button type="submit" class="btn-send">
              Enviar Correo a emilia.perez@correo.buap.mx &rarr;
            </button>
          </form>
        </div>

      </div>
    </div>
  </section>

</Layout>

<script>
  // Envío mediante cliente de correo predeterminado
  const contactoForm = document.getElementById('contacto-form') as HTMLFormElement | null;

  contactoForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const formData = new FormData(contactoForm);
    const nombre = formData.get('nombre') as string;
    const correo = formData.get('correo') as string;
    const asunto = formData.get('asunto') as string;
    const mensaje = formData.get('mensaje') as string;

    const mailtoUrl = `mailto:emilia.perez@correo.buap.mx?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(`Nombre: ${nombre}\nCorreo: ${correo}\n\nMensaje:\n${mensaje}`)}`;
    
    window.location.href = mailtoUrl;
  });
</script>

<style>
  :root {
    --green-dark: #1e4d2b;
    --green-medium: #2e6f40;
    --green-soft: #f0fdf4;
    --orange-accent: #d97706;
    --orange-hover: #b45309;
    --text-dark: #1f2937;
    --text-body: #4b5563;
    --bg-light: #f8faf8;
    --border-color: #e5e7eb;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* BANNER */
  .page-banner {
    background: linear-gradient(135deg, var(--green-dark) 0%, var(--green-medium) 100%);
    color: #ffffff;
    padding: 4.5rem 1.5rem;
    text-align: center;
  }

  .banner-tag {
    background-color: rgba(255, 255, 255, 0.18);
    padding: 0.3rem 0.9rem;
    border-radius: 20px;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    display: inline-block;
    margin-bottom: 1rem;
  }

  .page-banner h1 {
    font-size: 2.8rem;
    font-weight: 800;
    margin: 0 0 0.8rem 0;
  }

  .page-banner p {
    font-size: 1.15rem;
    opacity: 0.9;
    margin: 0 auto;
    max-width: 700px;
  }

  /* SECCIÓN CONTACTO */
  .contact-section {
    padding: 5rem 1.5rem;
    background-color: var(--bg-light);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3rem;
    align-items: start;
  }

  /* FICHA DE INFORMACIÓN */
  .info-card {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-top: 5px solid var(--green-medium);
    border-radius: 12px;
    padding: 2.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .info-header {
    margin-bottom: 2rem;
  }

  .badge-role {
    background-color: var(--green-soft);
    color: var(--green-dark);
    font-size: 0.78rem;
    font-weight: 800;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .info-header h2 {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--green-dark);
    margin: 0 0 0.35rem 0;
  }

  .sub-role {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--orange-accent);
    margin: 0;
  }

  .info-details {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .detail-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background-color: var(--green-soft);
    color: var(--green-medium);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .detail-item strong {
    display: block;
    font-size: 0.92rem;
    color: var(--text-dark);
    margin-bottom: 0.25rem;
  }

  .detail-item p {
    font-size: 0.95rem;
    color: var(--text-body);
    line-height: 1.5;
    margin: 0;
  }

  .email-link {
    color: var(--green-medium);
    font-weight: 700;
    text-decoration: none;
  }

  .email-link:hover {
    text-decoration: underline;
  }

  /* FORMULARIO */
  .form-wrapper {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 2.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .form-header {
    margin-bottom: 2rem;
  }

  .form-header h3 {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-dark);
    margin: 0 0 0.5rem 0;
  }

  .form-header p {
    font-size: 0.95rem;
    color: var(--text-body);
    margin: 0;
  }

  .direct-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-dark);
  }

  .form-group input,
  .form-group textarea {
    padding: 0.8rem;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    font-family: inherit;
    font-size: 0.95rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--green-medium);
    box-shadow: 0 0 0 3px rgba(46, 111, 64, 0.15);
  }

  .btn-send {
    background-color: var(--green-medium);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.98rem;
    padding: 0.9rem 1.5rem;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.2s ease;
    margin-top: 0.5rem;
  }

  .btn-send:hover {
    background-color: var(--green-dark);
  }

  /* RESPONSIVO */
  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>