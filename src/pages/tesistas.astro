---
import Layout from '../layouts/Layout.astro';
const thesis = [
  ['Maestría','Dolores Angélica Ramírez Peña','Diversidad Vertical de los líquenes cortícolas en un Bosque de Abies acapulcensis subsp. arguta en la Reserva Ecológica La Cortadura, Coatepec, Veracruz','Posgrado del Instituto de Ecología, A.C. (INECOL), Xalapa, Veracruz, México','En proceso'],
  ['Maestría','Aline Graciela Ruiz Cázares','Diversidad liquénica de Quercus laurina con diferentes diámetros en un bosque mesófilo de montaña de la Reserva La Cortadura, Coatepec, Ver.','Posgrado del Instituto de Ecología, A.C. (INECOL), Xalapa, Veracruz, México','En proceso'],
  ['Maestría','Octavio Córdova Chávez','Diversidad vertical de hongos liquenizados en forófitos del género Quercus en el bosque de niebla de La Cortadura, Coatepec, Veracruz','Posgrado del Instituto de Ecología, A.C. (INECOL), Xalapa, Veracruz, México','Concluida · 2015'],
  ['Licenciatura','Gabriela Águila Rodríguez','Composición de la comunidad liquénica en dos remanentes de bosque mesófilo con diferentes grados de conservación','Facultad de Ciencias Biológicas — BUAP','En proceso'],
  ['Licenciatura','Xitlali Sánchez Girón','Composición de la comunidad liquénica asociada a la Selva Baja Caducifolia de San Pedro Atlixco, Puebla','Facultad de Ciencias Biológicas — BUAP','En proceso'],
  ['Licenciatura','José Luis Hernández Velázquez','Líquenes utilizados por las aves en la construcción de sus nidos en la Universidad Autónoma del Estado de Morelos','Universidad Autónoma del Estado de Morelos (UAEM)','En proceso'],
];
---
<Layout title="Tesistas | Laboratorio de Liquenología BUAP">
  <section class="hero"><div class="hero-bg"></div><div class="hero-content"><span>Formación de recursos humanos</span><h1>Tesistas y <em>proyectos de grado</em></h1><p>Proyectos de investigación desarrollados por estudiantes de Maestría y Licenciatura en el laboratorio.</p></div></section>
  <main class="cream"><section class="wrap"><div class="filters"><button class="active" data-filter="Todas">Todas las tesis</button><button data-filter="Maestría">Maestría</button><button data-filter="Licenciatura">Licenciatura</button></div><div class="level" data-level="Maestría"><h2>Maestría (Posgrado)</h2><div class="rule"></div><p class="intro">Investigaciones avanzadas desarrolladas en colaboración con programas de posgrado nacional.</p><div class="thesis-grid">{thesis.filter(item => item[0] === 'Maestría').map(([level,name,topic,institution,status])=><article><div><span class="level-badge">{level}</span><span class="status">{status}</span></div><h3>{name}</h3><p class="topic">“{topic}”</p><small>⌂ {institution}</small></article>)}</div></div><div class="level" data-level="Licenciatura"><h2>Licenciatura</h2><div class="rule"></div><p class="intro">Tesis de grado desarrolladas por estudiantes de la Facultad de Ciencias Biológicas e instituciones afines.</p><div class="thesis-grid">{thesis.filter(item => item[0] === 'Licenciatura').map(([level,name,topic,institution,status])=><article><div><span class="level-badge bio">{level}</span><span class="status">{status}</span></div><h3>{name}</h3><p class="topic">“{topic}”</p><small>⌂ {institution}</small></article>)}</div></div></section></main>
</Layout>
<script>
  document.querySelectorAll<HTMLButtonElement>('.filters button').forEach(button => button.addEventListener('click', () => { document.querySelectorAll('.filters button').forEach(item => item.classList.remove('active')); button.classList.add('active'); document.querySelectorAll<HTMLElement>('.level').forEach(level => { level.style.display = button.dataset.filter === 'Todas' || level.dataset.level === button.dataset.filter ? 'block' : 'none'; }); }));
</script>
<style>
  .hero{position:relative;isolation:isolate;background:#12291c;color:#fff}.hero-bg{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(18,41,28,.95),rgba(18,41,28,.45)),url('https://images.unsplash.com/photo-1653794280668-963f2c25d173?auto=format&fit=crop&w=1800&q=80') center/cover}.hero-content,.wrap{max-width:1200px;margin:auto;padding:6rem 1.5rem}.hero-content span,.level-badge,.status{font:.7rem 'DM Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:#c9e265}.hero h1{margin:1.5rem 0 0;font:600 clamp(3rem,7vw,6rem)/.95 'Fraunces',serif}.hero em{font-weight:400;color:#c9e265}.hero p{max-width:40rem;color:#fffC;font-size:1.15rem;line-height:1.6}  .filters{display:flex;justify-content:center;flex-wrap:wrap;gap:.65rem;margin-bottom:5rem}.filters button{border:1px solid #dcdfd3;border-radius:999px;background:#fff;padding:.75rem 1.2rem;color:#1f4a32;font-weight:700;cursor:pointer}.filters button.active{background:#1f4a32;color:#c9e265;box-shadow:0 8px 18px -14px #12291c}.level{margin-bottom:5rem}.level h2{margin:0;color:#1f4a32;font:600 clamp(2.5rem,5vw,4.5rem)/1 'Fraunces',serif}.rule{width:3.5rem;height:.25rem;margin:1.3rem 0;background:#c9e265}.intro{color:#5c6a60}.thesis-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem}.thesis-grid article{display:flex;flex-direction:column;min-height:19rem;padding:1.5rem;border:1px solid #dcdfd3;border-radius:1rem;background:#fff;transition:transform .35s var(--motion-ease, ease),box-shadow .35s var(--motion-ease, ease)}.thesis-grid article:hover{transform:translateY(-.45rem);box-shadow:0 1.5rem 3rem -2rem rgba(18,41,28,.5)}.level-badge,.status{display:inline-block;padding:.4rem .65rem;border-radius:.25rem;background:#1f4a32}.status{float:right;background:#c9e265;color:#1f4a32}.level-badge.bio{background:#2f6b46}.thesis-grid h3{margin:1.5rem 0 .75rem;color:#1f4a32;font:600 1.5rem 'Fraunces',serif}.topic{flex:1;color:#16201acc;line-height:1.55}.thesis-grid small{color:#5c6a60;line-height:1.4}@media(max-width:800px){.thesis-grid{grid-template-columns:1fr}}
</style>
