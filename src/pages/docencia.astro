---
import Layout from '../layouts/Layout.astro';
const courses = [
  ['Licenciatura en Biología','Biología de Hongos','Estudio morfológico, anatómico, filogenético y funcional de los grandes grupos fúngicos y sus interacciones simbióticas.','https://images.unsplash.com/photo-1600995616615-52152934de1d?auto=format&fit=crop&w=1000&q=80'],
  ['Licenciatura en Biología','Biología Vegetal','Análisis integral de la estructura, diversidad, fisiología y ecología de los organismos vegetales y autótrofos.','https://images.unsplash.com/photo-1774523561009-810725a23c69?auto=format&fit=crop&w=1000&q=80'],
  ['Licenciatura / Posgrado','Biogeografía','Estudio de los patrones de distribución espacial y temporal de la biodiversidad liquénica y su respuesta al cambio ambiental.','https://images.unsplash.com/photo-1762375398256-c844ac0b6512?auto=format&fit=crop&w=1000&q=80'],
];
const workshops = [
  ['2015','Taller especializado','Guía de Parmeliáceas de México (con énfasis en la Península de Yucatán)','21 – 25 de septiembre de 2015','Laboratorio de Liquenología, Universidad Nacional Autónoma de México (UNAM)'],
  ['2013','Seminario & taller','Introducción al conocimiento de los líquenes','30 de enero de 2013','9ª Semana del Biólogo — Escuela de Biología, BUAP'],
  ['2011','Diplomado de capacitación','Tópicos de Ecología y Evaluaciones Liquenológicas','10 – 14 de septiembre de 2011','UAEM / SEMARNAT'],
];
---
<Layout title="Docencia | Laboratorio de Liquenología BUAP">
  <section class="hero"><div class="hero-bg"></div><div class="hero-content"><span>Formación académica y capacitación</span><h1>Docencia y <em>talleres</em></h1><p>Cursos universitarios, talleres especializados, seminarios y diplomados impartidos por el laboratorio.</p></div></section>
  <main><section class="wrap"><h2 class="center">Cursos impartidos</h2><div class="rule center-rule"></div><div class="courses">{courses.map(([level,title,text,image])=><article><img src={image} alt={title} loading="lazy"/><div class="shade"></div><div class="course-copy"><small>{level}</small><h3>{title}</h3><p>{text}</p></div></article>)}</div></section>
  <section class="cream"><div class="wrap"><h2>Talleres, seminarios y diplomados</h2><div class="rule"></div><div class="workshops">{workshops.map(([year,type,title,date,place])=><article><div class="workshop-top"><b>{year}</b><span>{type}</span></div><div class="workshop-copy"><h3>{title}</h3><p>{place}</p><small>▣ {date}</small></div></article>)}</div></div></section></main>
</Layout>
<style>
  .hero{position:relative;isolation:isolate;background:#12291c;color:#fff}.hero-bg{position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(18,41,28,.95),rgba(18,41,28,.45)),url('https://images.unsplash.com/photo-1653794280668-963f2c25d173?auto=format&fit=crop&w=1800&q=80') center/cover}.hero-content,.wrap{max-width:1200px;margin:auto;padding:6rem 1.5rem}.hero-content span,.course-copy small,.workshop-top span{font:.7rem 'DM Mono',monospace;letter-spacing:.14em;text-transform:uppercase;color:#c9e265}.hero h1{margin:1.5rem 0 0;font:600 clamp(3rem,7vw,6rem)/.95 'Fraunces',serif}.hero em{font-weight:400;color:#c9e265}.hero p{max-width:40rem;color:#fffC;font-size:1.15rem;line-height:1.6}.wrap>h2{margin:0;color:#1f4a32;font:600 clamp(2.5rem,5vw,4.5rem)/1 'Fraunces',serif}.center{text-align:center}.rule{width:3.5rem;height:.25rem;margin:1.3rem 0 3rem;background:#c9e265}.center-rule{margin-left:auto;margin-right:auto}.courses{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem}.courses article{position:relative;min-height:32rem;display:flex;align-items:end;overflow:hidden;border-radius:1rem;background:#12291c;color:#fff;isolation:isolate}.courses img,.shade{position:absolute;inset:0;width:100%;height:100%}.courses img{z-index:-2;object-fit:cover;transition:.7s}.shade{z-index:-1;background:linear-gradient(to top,#12291c,rgba(18,41,28,.45),transparent)}.courses article:hover img{transform:scale(1.08)}.course-copy{padding:1.75rem}.course-copy h3,.workshop-copy h3{margin:.6rem 0;font:600 2rem/1.1 'Fraunces',serif}.course-copy p{color:#fffc;line-height:1.55}.cream{background:#f4f1e8}.workshops{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem}.workshops article{border:1px solid #dcdfd3;border-radius:1rem;background:#fff;overflow:hidden}.workshop-top{display:flex;justify-content:space-between;align-items:center;padding:1rem 1.25rem;background:#1f4a32}.workshop-top b{color:#fff;font:2rem 'Fraunces',serif}.workshop-copy{display:flex;flex-direction:column;min-height:14rem;padding:1.5rem}.workshop-copy h3{font-size:1.5rem;color:#1f4a32}.workshop-copy p{margin:auto 0;color:#5c6a60;line-height:1.5}.workshop-copy small{margin-top:1rem;color:#d9a43b;font-weight:700}@media(max-width:800px){.courses,.workshops{grid-template-columns:1fr}}
</style>
