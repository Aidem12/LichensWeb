---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const photos = {
  hero: 'https://images.unsplash.com/photo-1731079067238-4b728b4e6c40?auto=format&fit=crop&w=2000&q=80',
  yellow: 'https://images.unsplash.com/photo-1777133046305-08459fd02208?auto=format&fit=crop&w=1200&q=80',
  fog: 'https://images.unsplash.com/photo-1702474447694-e8c8dc2508e0?auto=format&fit=crop&w=1200&q=80',
  moss: 'https://images.unsplash.com/photo-1653794280668-963f2c25d173?auto=format&fit=crop&w=1200&q=80',
  tall: 'https://images.unsplash.com/photo-1679801250448-d3fbd4d6a3b2?auto=format&fit=crop&w=1200&q=80',
  forest: 'https://images.unsplash.com/photo-1761461922930-9afd5bf09593?auto=format&fit=crop&w=1400&q=80',
  cactus: 'https://images.unsplash.com/photo-1757912190224-a0b069bf4130?auto=format&fit=crop&w=1200&q=80',
  book: 'https://images.unsplash.com/photo-1517770413964-df8ca61194a6?auto=format&fit=crop&w=900&q=80',
  branch: 'https://images.unsplash.com/photo-1775302032848-1e4a6ee538cd?auto=format&fit=crop&w=900&q=80',
};

const posts = [
  {
    tag: 'Ecología forestal',
    title: 'Estructura forestal y su influencia en las comunidades liquénicas corticícolas',
    text: 'Análisis de parámetros ecológicos en bosques mesófilos y templados del centro y sur de México.',
    date: 'Octubre 2026',
    image: photos.fog,
    alt: 'Bosque cubierto de niebla',
  },
  {
    tag: 'Taxonomía',
    title: 'Diversidad y distribución de líquenes en zonas áridas de Tehuacán-Cuicatlán',
    text: 'Estudio taxonómico de especímenes adaptados a condiciones de estrés hídrico extremo.',
    date: 'Septiembre 2026',
    image: photos.cactus,
    alt: 'Cactus columnares en una zona árida',
  },
  {
    tag: 'Bioindicadores',
    title: 'Uso de líquenes epífitos como bioindicadores de calidad del aire urbano',
    text: 'Evaluación de la acumulación de metales pesados en talos liquénicos en zonas metropolitanas.',
    date: 'Agosto 2026',
    image: photos.yellow,
    alt: 'Liquen amarillo sobre corteza de árbol',
  },
];

const pillars = [
  ['Conócenos', '¿Quién está detrás de liquenes.com? Líneas e integrantes del laboratorio.', `${base}/conocenos`, photos.branch, 'Conoce al equipo del laboratorio'],
  ['Investigación', 'Proyectos y publicaciones realizadas por el laboratorio de liquenología BUAP.', `${base}/investigacion`, photos.forest, 'Investigación en campo'],
  ['Docencia', 'Cursos, colaboración en talleres, seminarios y diplomados.', `${base}/docencia`, photos.moss, 'Musgo y liquen sobre un tronco'],
  ['Tesistas', 'Tesis terminadas y en proceso, maestría y licenciatura.', `${base}/tesistas`, photos.tall, 'Muestreo de flora liquénica'],
];
---

<Layout title="Líquenes — Laboratorio de Liquenología BUAP">
  <main>
    <section id="inicio" class="hero">
      <img src={photos.hero} alt="Primer plano de un liquen verde sobre corteza" />
      <div class="hero-shade"></div>
      <div class="hero-inner">
        <span class="eyebrow">Facultad de Ciencias Biológicas — BUAP</span>
        <h1>Laboratorio de <em>Liquenología</em></h1>
        <p>Investigación, conservación y divulgación científica sobre la taxonomía y ecología de las comunidades liquénicas en México.</p>
        <div class="actions">
          <a class="button button-lime" href="#conocenos">Conocer el Laboratorio</a>
          <a class="button button-outline" href="#publicaciones">Ver Publicaciones</a>
        </div>
      </div>
    </section>

    <section id="conocenos" class="welcome section-shell">
      <div class="welcome-copy">
        <h2>¡Bienvenidos<em>!</em></h2>
        <div class="rule"></div>
        <p class="lead">La <strong>Taxonomía y Ecología de Líquenes</strong> es una línea de investigación que se viene desarrollando en el laboratorio de <strong>Biología Vegetal</strong> de la Facultad de Ciencias Biológicas.</p>
        <p>Los estudios se están llevando a cabo en los bosques templados, bosques mesófilos de montaña, selvas tropicales y zonas áridas de los estados de <em>Estado de México, Guerrero, Morelos, Oaxaca, Puebla, Tlaxcala y Veracruz</em>. El objetivo es explicar el impacto de la estructura forestal en las comunidades liquénicas, a partir del análisis de algunos parámetros ecológicos.</p>
        <p class="contact-line">¿Quieres conocer más sobre liquenes.com? <a href={`${base}/contacto`}>Contáctanos →</a></p>
      </div>
      <div class="gallery">
        {[ [photos.yellow, 'Liquen amarillo sobre corteza'], [photos.fog, 'Bosque templado con niebla'], [photos.moss, 'Superficie musgosa en el bosque'], [photos.tall, 'Muestra de flora liquénica'] ].map(([src, alt], index) => (
          <button class={`gallery-item gallery-${index}`} aria-label={`Ampliar: ${alt}`} data-src={src} data-alt={alt}>
            <img src={src} alt={alt} loading="lazy" />
            <span>Ampliar</span>
          </button>
        ))}
      </div>
    </section>

    <section id="publicaciones" class="publications">
      <div class="section-shell">
        <div class="section-heading split">
          <h2>Divulgación y publicaciones <em>recientes</em></h2>
          <p>Artículos, boletines y avances del laboratorio.</p>
        </div>
        <div class="post-grid">
          {posts.map((post) => (
            <article class="post-card">
              <img src={post.image} alt={post.alt} loading="lazy" />
              <div class="card-shade"></div>
              <span class="tag">{post.tag}</span>
              <div class="post-copy">
                <small>{post.date}</small>
                <h3>{post.title}</h3>
                <p>{post.text}</p>
                <a href={`${base}/investigacion`}>Leer artículo →</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pillars section-shell">
      <div class="section-heading split">
        <div>
          <h2>Explora nuestro <em>trabajo</em></h2>
          <div class="rule"></div>
        </div>
        <p>Conoce las líneas que sostienen nuestro trabajo científico y académico.</p>
      </div>
      <div class="pillar-grid">
        {pillars.map(([title, description, href, image, alt]) => (
          <a class="pillar" href={href}>
            <img src={image} alt={alt} loading="lazy" />
            <div class="pillar-body">
              <h3>{title}</h3>
              <p>{description}</p>
              <span>Explorar sección →</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="quote">
      <div class="section-shell">
        <div class="quote-mark">“</div>
        <blockquote>A veces, las algas y los hongos se divorcian, por riñas y disputas. Según ellas, ellos las tienen encerradas y no las dejan ver la luz. Según ellos, ellas los empalagan de tanto darles azúcar noche y día.</blockquote>
        <cite>— EDUARDO GALEANO —</cite>
      </div>
    </section>
  </main>

  <dialog id="image-modal">
    <button id="close-modal" aria-label="Cerrar imagen">×</button>
    <img id="modal-image" src="" alt="" />
    <p id="modal-caption"></p>
  </dialog>
</Layout>

<script>
  const modal = document.querySelector('#image-modal') as HTMLDialogElement | null;
  const modalImage = document.querySelector('#modal-image') as HTMLImageElement | null;
  const caption = document.querySelector('#modal-caption');
  document.querySelectorAll<HTMLButtonElement>('.gallery-item').forEach((item) => {
    item.addEventListener('click', () => {
      if (!modal || !modalImage) return;
      modalImage.src = item.dataset.src || '';
      modalImage.alt = item.dataset.alt || '';
      if (caption) caption.textContent = item.dataset.alt || '';
      modal.showModal();
    });
  });
  document.querySelector('#close-modal')?.addEventListener('click', () => modal?.close());
  modal?.addEventListener('click', (event) => {
    if (event.target === modal) modal.close();
  });
</script>

<style>
  :global(:root) {
    --moss: #1f4a32;
    --deep: #12291c;
    --leaf: #2f6b46;
    --lime: #c9e265;
    --bone: #f4f1e8;
    --ink: #16201a;
    --mute: #5c6a60;
    --rule: #dcdfd3;
    --ochre: #d9a43b;
  }
  :global(body) { color: var(--ink); background: #fff; }
  main { overflow: hidden; }
  .section-shell { max-width: 1200px; margin: 0 auto; padding-left: 1.5rem; padding-right: 1.5rem; }
  .hero { position: relative; min-height: min(46rem, 88vh); display: flex; align-items: flex-end; background: var(--deep); color: #fff; isolation: isolate; }
  .hero > img, .hero-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero > img { z-index: -2; object-fit: cover; opacity: .5; mix-blend-mode: luminosity; }
  .hero-shade { z-index: -1; background: linear-gradient(to top, var(--deep), rgba(18,41,28,.35), transparent); }
  .hero-inner { width: 1200px; max-width: 100%; margin: 0 auto; padding: 6rem 1.5rem 4rem; }
  .eyebrow, .tag { display: inline-block; font: .68rem 'DM Mono', monospace; letter-spacing: .16em; text-transform: uppercase; }
  .eyebrow { border: 1px solid rgba(255,255,255,.3); border-radius: 999px; padding: .45rem 1rem; color: var(--lime); }
  h1, h2, h3, blockquote { font-family: 'Fraunces', Georgia, serif; }
  h1 { max-width: 950px; margin: 1.5rem 0 0; font-size: clamp(3.4rem, 8.5vw, 7.5rem); line-height: .92; letter-spacing: -.04em; }
  h1 em, h2 em { color: var(--lime); font-weight: 400; }
  .hero p { max-width: 38rem; margin: 1.75rem 0 0; color: rgba(255,255,255,.8); font-size: 1.1rem; line-height: 1.7; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2.25rem; }
  .button { border-radius: 999px; padding: .9rem 1.7rem; font-weight: 700; font-size: .9rem; text-decoration: none; transition: .2s ease; }
  .button:hover { transform: translateY(-2px); }
  .button-lime { background: var(--lime); color: var(--deep); }
  .button-outline { border: 1px solid rgba(255,255,255,.55); color: #fff; }
  .button-outline:hover { background: rgba(255,255,255,.1); }
  .welcome { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; padding-top: 6rem; padding-bottom: 6rem; }
  h2 { margin: 0; color: var(--moss); font-size: clamp(2.8rem, 5vw, 5rem); line-height: .98; letter-spacing: -.03em; }
  .welcome h2 em { color: var(--leaf); }
  .rule { width: 3.5rem; height: .25rem; margin-top: 1.5rem; background: var(--lime); }
  .welcome-copy p { max-width: 35rem; margin: 1.5rem 0 0; color: var(--mute); line-height: 1.75; }
  .welcome-copy .lead { margin-top: 2.25rem; color: rgba(22,32,26,.85); font-size: 1.08rem; }
  strong { color: var(--moss); }
  .contact-line { display: flex; flex-wrap: wrap; gap: 1rem; border-top: 1px solid var(--rule); padding-top: 1.5rem; font-weight: 700; color: var(--ink) !important; }
  a { color: inherit; }
  .contact-line a, .post-copy a, .pillar-body span { color: var(--ochre); text-decoration: none; }
  .gallery { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .gallery-item { position: relative; min-height: 12rem; overflow: hidden; padding: 0; border: 0; border-radius: 1rem; background: var(--moss); cursor: pointer; }
  .gallery-item img { width: 100%; height: 100%; min-height: 12rem; display: block; object-fit: cover; transition: .5s ease; }
  .gallery-item span { position: absolute; inset: 0; display: grid; place-items: center; opacity: 0; background: rgba(31,74,50,.75); color: #fff; font-weight: 700; transition: .3s; }
  .gallery-item:hover img { transform: scale(1.06); }
  .gallery-item:hover span, .gallery-item:focus span { opacity: 1; }
  .gallery-1 { margin-top: 2.5rem; } .gallery-2 { margin-top: -2.5rem; }
  .publications, .quote { background: var(--bone); }
  .publications { padding: 6rem 0; }
  .section-heading { margin-bottom: 3rem; } .section-heading.split { display: flex; justify-content: space-between; align-items: end; gap: 2rem; }
  .section-heading h2 { max-width: 42rem; font-size: clamp(2.5rem, 5vw, 4.5rem); } .section-heading p { max-width: 18rem; color: var(--mute); line-height: 1.6; }
  .post-grid, .pillar-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .post-card { position: relative; min-height: 31rem; display: flex; align-items: end; overflow: hidden; border-radius: 1rem; background: var(--deep); color: #fff; isolation: isolate; }
  .post-card > img, .card-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .post-card > img { z-index: -2; object-fit: cover; transition: .7s; } .card-shade { z-index: -1; background: linear-gradient(to top, var(--deep), rgba(18,41,28,.5), transparent); }
  .post-card:hover > img { transform: scale(1.08); }
  .tag { position: absolute; top: 1.25rem; left: 1.25rem; padding: .4rem .75rem; border-radius: .25rem; background: var(--lime); color: var(--deep); }
  .post-copy { padding: 1.75rem; } .post-copy small { font: .7rem 'DM Mono', monospace; letter-spacing: .12em; color: var(--lime); text-transform: uppercase; }
  .post-copy h3 { margin: .75rem 0 0; font-size: 1.65rem; line-height: 1.15; } .post-copy p { max-height: 0; overflow: hidden; margin: 0; color: rgba(255,255,255,.8); line-height: 1.55; transition: .4s; }
  .post-card:hover .post-copy p { max-height: 8rem; margin-top: .75rem; } .post-copy a { display: inline-block; margin-top: 1.25rem; font-size: .9rem; font-weight: 700; }
  .pillars { padding-top: 6rem; padding-bottom: 6rem; }
  .pillar-grid { grid-template-columns: repeat(4, 1fr); }
  .pillar { overflow: hidden; border: 1px solid var(--rule); border-radius: 1rem; background: #fff; text-decoration: none; transition: .3s; }
  .pillar:hover { transform: translateY(-.4rem); box-shadow: 0 1.5rem 3rem -2rem rgba(18,41,28,.5); }
  .pillar > img { width: 100%; height: 11rem; display: block; object-fit: cover; transition: .5s; } .pillar:hover > img { transform: scale(1.05); }
  .pillar-body { padding: 1.5rem; } .pillar-body h3 { margin: 0; color: var(--moss); font-size: 1.5rem; text-transform: uppercase; } .pillar-body p { min-height: 4.5rem; color: var(--mute); font-size: .92rem; line-height: 1.5; } .pillar-body span { font-size: .9rem; font-weight: 700; }
  .quote { padding: 4.5rem 0; text-align: center; background: #fff; } .quote-mark { color: var(--lime); font: 600 4rem/1 'Fraunces', serif; height: 2.5rem; } blockquote { max-width: 58rem; margin: 1rem auto 1.75rem; color: var(--leaf); font-size: clamp(1.35rem, 2.2vw, 2rem); font-style: italic; line-height: 1.7; } cite { color: #5e8a6c; font: .7rem 'DM Mono', monospace; letter-spacing: .18em; }
  dialog { max-width: 85vw; padding: 1rem; border: 0; border-radius: 1rem; background: var(--deep); } dialog::backdrop { background: rgba(0,0,0,.8); } dialog img { max-width: 80vw; max-height: 75vh; display: block; object-fit: contain; } dialog p { margin: .75rem 0 0; color: #fff; text-align: center; } #close-modal { position: absolute; top: -.75rem; right: -.75rem; width: 2.25rem; height: 2.25rem; border: 2px solid #fff; border-radius: 50%; background: var(--leaf); color: #fff; font-size: 1.5rem; cursor: pointer; }
  @media (max-width: 800px) { .welcome, .post-grid, .pillar-grid { grid-template-columns: 1fr 1fr; } .welcome { gap: 2.5rem; } .welcome-copy, .section-heading.split { grid-column: 1 / -1; } .post-grid { grid-template-columns: 1fr; } .post-card { min-height: 27rem; } .pillar-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .welcome, .pillar-grid { grid-template-columns: 1fr; } .gallery { margin-top: 1rem; } .section-heading.split { display: block; } .section-heading p { margin-top: 1rem; } }
</style>
